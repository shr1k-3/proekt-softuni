@model MovieCatalog.Models.Movie
@{ ViewData["Title"] = "Details"; }

<h1>@Model.Title</h1>
<dl class="row">
    <dt class="col-sm-2">Year</dt><dd class="col-sm-10">@Model.Year</dd>
    <dt class="col-sm-2">Rating</dt><dd class="col-sm-10">@Model.Rating</dd>
    <dt class="col-sm-2">Genre</dt><dd class="col-sm-10">@Model.Genre?.Name</dd>
    <dt class="col-sm-2">Director</dt><dd class="col-sm-10">@Model.Director?.Name</dd>
    <dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Description</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
