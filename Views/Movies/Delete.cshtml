@model MovieCatalog.Models.Movie
@{ ViewData["Title"] = "Delete"; }

<h1>Delete movie</h1>
<h3 class="text-danger">Are you sure you want to delete this movie?</h3>
<dl class="row">
    <dt class="col-sm-2">Title</dt><dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Year</dt><dd class="col-sm-10">@Model.Year</dd>
    <dt class="col-sm-2">Genre</dt><dd class="col-sm-10">@Model.Genre?.Name</dd>
    <dt class="col-sm-2">Director</dt><dd class="col-sm-10">@Model.Director?.Name</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
